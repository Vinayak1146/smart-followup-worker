# Copy to .env and adjust. Every value here has a working default, so the
# prototype runs end to end with an empty .env — it just uses the deterministic
# rule engine and reports zero token cost.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# --- Inference (optional) --------------------------------------------------
# LLM_PROVIDER=gemini                 # gemini | openai
# LLM_API_KEY=your-key-here
# Measured against the Gemini free tier, the large flash models returned
# "503 high demand" or hung past the read timeout, while the lite models
# answered in ~2.5s. Defaults therefore target the lite tier.
# LLM_FAST_MODEL=gemini-flash-lite-latest
# LLM_REASONING_MODEL=gemini-3.1-flash-lite
# A 503 is a queue, not a bug: transient failures are retried with linear
# backoff, then the next model id below is tried, and only then do we degrade.
# LLM_FALLBACK_MODELS=gemini-flash-lite-latest
# LLM_MAX_ATTEMPTS=3
# LLM_RETRY_BACKOFF_SECONDS=1.5
# LLM_TIMEOUT_SECONDS=30

# --- Worker policy --------------------------------------------------------
# FOLLOW_UP_MIN_INACTIVE_DAYS=30
# FOLLOW_UP_MAX_INACTIVE_DAYS=180
# Any discount moves the owner's margin, so the default is that ANY discount
# needs a human decision. Raise it to let the worker grant small incentives alone.
# MAX_AUTONOMOUS_DISCOUNT_PCT=0
# MAX_PROPOSABLE_DISCOUNT_PCT=25

# --- Harness --------------------------------------------------------------
# LANGGRAPH_CHECKPOINT_PATH=agent_checkpoints.sqlite
# WORKER_RECURSION_LIMIT=40
# TOOL_MAX_ATTEMPTS=3

# --- PostgreSQL (optional; SQLite is the default) -------------------------
# POSTGRES_DB=followup
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
